    "rm canary",
    "rm -rf canary",
    "/bin/rm canary",
    "r\\m canary",
    "'rm' canary",
    "\"r\"m canary",
    "sh -c 'rm canary'",
    "bash -c \"rm canary\"",
    "eval rm canary",
    "exec rm canary",
    "command rm canary",
    "env rm canary",
    "find . -name canary -delete",
    "find . -name canary -exec rm {} +",
    "echo canary | xargs rm",
    "X=rm; $X canary",
    "${X:-rm} canary",
    "$(echo rm) canary",
    "`echo rm` canary",
    "echo cm0gY2FuYXJ5 | base64 -d | sh",
    "printf 'rm canary' | sh",
    "python3 -c 'import os; os.remove(\"canary\")'",
    "node -e 'require(\"fs\").rmSync(\"canary\")'",
    "perl -e 'unlink \"canary\"'",
    "awk 'BEGIN{system(\"rm canary\")}'",
    "ls; rm canary",
    "ls && rm canary",
    "ls || rm canary",
    "ls | rm canary",
    "go version; rm canary",
    "git status && rm canary",
    "echo gone > canary",
    "cat /dev/null > canary",
    "truncate -s 0 canary",
    "cp /dev/null canary",
    "mv canary elsewhere",
    "sed -i.bak s/keep/gone/ canary",
    "tee canary < /dev/null",
    "rm ../outside/canary",
    "echo gone > ../outside/canary",
    "git reset --hard HEAD~1",
    "git clean -fdx",
    "git checkout -- .",
    "git rm -f canary",
    "git stash -u",
    "git branch -D nothing",
    "git push --force origin main",
    "sudo -n rm canary",
    "git stash",
    "git stash drop",
    "git switch -f main",
    "git switch --discard-changes main",
    "git commit --amend -m gone",
    "git commit -a --amend --no-edit",
    "git pull --rebase",
    "git pull --force",
    "git fetch --prune",
    "go mod tidy && rm canary",
    "npm run build; rm canary"
